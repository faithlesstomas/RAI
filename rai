#!/usr/bin/env python

import sys

# Komponenty od Agno, Rich i Click
from agno.agent import Agent
from agno.models.ollama import Ollama
from rich.console import Console
from rich.markdown import Markdown
from rich.panel import Panel
import click

# Inicjalizacja konsoli globalnie, aby była dostępna wszędzie
console = Console()

def setup_agent(system_prompt):
    """Inicjalizuje agenta Agno i prawidłowo ustawia jego kontekst."""
    try:
        # ZMIANA #1: Prompt systemowy jest przekazywany bezpośrednio do konfiguracji modelu.
        # To jest czyste, proste i poprawne podejście.
        agent = Agent(
            model=Ollama(id="gemma2:2b")
        )
        return agent

    except Exception as e:
        console.print(f"[bold red]BŁĄD: Nie udało się zainicjalizować agenta: {e}[/bold red]")
        console.print("[yellow]Czy na pewno serwer Ollama jest uruchomiony i posiada wskazany model?[/yellow]")
        sys.exit(1)

def run_single_query(agent, prompt):
    """Wykonuje pojedyncze zapytanie i wyświetla odpowiedź."""
    with console.status("[bold blue]AI myśli...[/bold blue]", spinner="dots"):
        response = agent.run(prompt)

    console.print("\n[bold blue]Asystent AI:[/]")

    # ZMIANA #2: Wyciągamy treść tekstową z obiektu odpowiedzi.
    markdown_response = Markdown(response.content)
    console.print(markdown_response)

def run_interactive_chat(agent):
    """Uruchamia pętlę interaktywnego czatu."""
    welcome_message = "[bold]Witaj w Asystencie AI![/bold]\n\nZasilany lokalnie przez [cyan]Ollama[/cyan] i [cyan]Agno[/cyan].\nWpisz 'wyjdź', aby zakończyć."
    console.print(Panel(welcome_message, title="Asystent CLI - Działa!", border_style="green"))

    while True:
        try:
            user_input = console.input("[bold green]Ty:[/]")
            if user_input.lower() in ["wyjdź", "exit", "quit", "q"]:
                break

            if not user_input.strip():
                continue

            with console.status("[bold blue]AI myśli...[/bold blue]", spinner="dots"):
                response = agent.run(user_input)

            console.print("\n[bold blue]Asystent AI:[/]")

            # ZMIANA #3: Również tutaj wyciągamy treść z obiektu odpowiedzi.
            markdown_response = Markdown(response.content)
            console.print(markdown_response)
            console.print("---")
        except KeyboardInterrupt:
            break
    console.print("\n[yellow]Do widzenia![/yellow]")

@click.command()
@click.argument('prompt', required=False)
@click.option(
    '-s', '--system',
    default="Jesteś pomocnym asystentem AI. Odpowiadaj zwięźle i precyzyjnie.",
    help="Definiuje prompt systemowy dla AI."
)

def main(prompt, system):
    """
    Asystent AI w wierszu poleceń, zasilany przez lokalny model Ollama i framework Agno.

    Jeśli podasz PROMPT, wykona pojedyncze zapytanie.
    W przeciwnym razie, uruchomi tryb interaktywnego czatu.
    """
    agent = setup_agent(system_prompt=system)

    if prompt:
        if not sys.stdin.isatty():
            piped_content = sys.stdin.read()
            full_prompt = f"{prompt}\n\nOto treść do przetworzenia:\n\n---\n{piped_content}"
            run_single_query(agent, full_prompt)
        else:
            run_single_query(agent, prompt)
    else:
        run_interactive_chat(agent)

if __name__ == "__main__":
    main()
