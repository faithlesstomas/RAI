        "max_ram_bytes": {
          "minimum": 0,
          "title": "Max Ram Bytes",
          "type": "integer"
        },
        "max_vram_bytes": {
          "minimum": 0,
          "title": "Max Vram Bytes",
          "type": "integer"
        },
        "cancellation_deadline": {
