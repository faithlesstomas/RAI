          "title": "Provenance",
          "type": "array"
        }
      },
      "required": [
        "producer",
        "session_id",
        "turn_id",
        "user_turn_id",
        "request_id",
        "manifest_id",
        "text"
      ],
      "title": "AssistantResponse",
      "type": "object"
    },
    "AssistantSessionId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
