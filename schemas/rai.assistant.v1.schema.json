        },
        "admitted_memory_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Admitted Memory Ids",
          "type": "array"
        },
        "memory_operation_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Memory Operation Ids",
          "type": "array"
        },
        "provenance": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProvenanceReference"
