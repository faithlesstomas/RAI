          "title": "Record Type",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerIdentity"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "session_id": {
          "$ref": "#/$defs/AssistantSessionId"
        },
        "turn_id": {
          "minLength": 1,
          "title": "Turn Id",
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/AssistantContextManifest"
        },
        "content": {
          "additionalProperties": true,
          "title": "Content",
          "type": "object"
        },
        "provenance": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProvenanceReference"
          },
          "title": "Provenance",
          "type": "array"
        }
      },
      "required": [
        "producer",
        "session_id",
        "turn_id",
        "manifest",
        "content"
      ],
      "title": "AssistantContextPackage",
      "type": "object"
    },
    "AssistantResponse": {
      "additionalProperties": false,
      "description": "Exactly one terminal outcome for an accepted turn.",
