          "type": "string"
        },
        "provenance": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProvenanceReference"
          },
          "title": "Provenance",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "producer",
        "session_id",
        "role",
        "text"
      ],
      "title": "ConversationTurn",
      "type": "object"
    },
    "DataClass": {
      "description": "Policy classification attached to persisted and outbound data.",
      "enum": [
        "PUBLIC",
        "LOCAL",
        "PRIVATE",
        "SECRET",
        "BLOCKED"
