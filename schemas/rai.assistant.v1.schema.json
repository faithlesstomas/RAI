{
  "$defs": {
    "AssistantContextManifest": {
      "additionalProperties": false,
      "description": "Inspectable provenance manifest for an assembled assistant context.",
      "properties": {
        "record_type": {
          "const": "assistant_context_manifest",
          "default": "assistant_context_manifest",
          "title": "Record Type",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerIdentity"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "session_id": {
          "$ref": "#/$defs/AssistantSessionId"
        },
        "turn_id": {
          "minLength": 1,
          "title": "Turn Id",
          "type": "string"
        },
        "recent_turn_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Recent Turn Ids",
          "type": "array"
        },
        "episodic_turn_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Episodic Turn Ids",
          "type": "array"
        },
        "external_evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "External Evidence Ids",
          "type": "array"
        },
        "durable_memory_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Durable Memory Ids",
          "type": "array"
        },
        "ranking_reasons": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Ranking Reasons",
          "type": "object"
        },
        "exclusions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Exclusions",
          "type": "array"
        },
        "redactions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Redactions",
          "type": "array"
        },
        "routing_decision": {
          "default": "no_evidence",
          "enum": [
            "recent_conversation",
            "compact_memory",
            "raw_evidence_fallback",
            "no_evidence"
          ],
          "title": "Routing Decision",
          "type": "string"
        },
        "route_candidates": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Route Candidates",
          "type": "array"
        },
        "rejected_routes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Rejected Routes",
          "type": "array"
        },
        "sufficiency_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Sufficiency Score",
          "type": "number"
        },
        "sufficiency_factors": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Sufficiency Factors",
          "type": "object"
        },
        "sufficiency_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Sufficiency Reasons",
          "type": "array"
        },
        "fallback_used": {
          "default": false,
          "title": "Fallback Used",
          "type": "boolean"
        },
        "evidence_character_budget": {
          "default": 0,
          "minimum": 0,
          "title": "Evidence Character Budget",
          "type": "integer"
        },
        "retriever_version": {
          "default": "1.0.0",
          "minLength": 1,
          "title": "Retriever Version",
          "type": "string"
        },
        "policy_version": {
          "default": "1.0.0",
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "backend_name": {
          "default": "unknown",
          "minLength": 1,
          "title": "Backend Name",
          "type": "string"
        },
        "model_name": {
          "default": "unknown",
          "minLength": 1,
          "title": "Model Name",
          "type": "string"
        },
        "model_artifact_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Artifact Version"
        },
        "prompt_template_version": {
          "default": "unknown",
          "minLength": 1,
          "title": "Prompt Template Version",
          "type": "string"
        },
        "actual_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Tokens"
        },
        "actual_characters": {
          "default": 0,
          "minimum": 0,
          "title": "Actual Characters",
          "type": "integer"
        },
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AssistantContextManifestItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "producer",
        "session_id",
        "turn_id"
      ],
      "title": "AssistantContextManifest",
      "type": "object"
    },
    "AssistantContextManifestItem": {
      "additionalProperties": false,
      "description": "Item recorded in the assistant context manifest.",
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        },
        "layer": {
          "minLength": 1,
          "title": "Layer",
          "type": "string"
        },
        "data_class": {
          "$ref": "#/$defs/DataClass",
          "default": "LOCAL"
        },
        "domain_scope": {
          "default": "general",
          "minLength": 1,
          "title": "Domain Scope",
          "type": "string"
        },
        "purpose": {
          "default": "assistant",
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "ranking_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ranking Reason"
        },
        "fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "redactions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Redactions",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "source_type",
        "layer"
      ],
      "title": "AssistantContextManifestItem",
      "type": "object"
    },
    "AssistantContextPackage": {
      "additionalProperties": false,
      "description": "Reconstructed, bounded context package for an assistant inference.",
      "properties": {
        "record_type": {
          "const": "assistant_context_package",
