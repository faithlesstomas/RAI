{
  "$defs": {
    "AssistantContextManifest": {
      "additionalProperties": false,
      "description": "Inspectable provenance manifest for an assembled assistant context.",
      "properties": {
        "record_type": {
          "const": "assistant_context_manifest",
          "default": "assistant_context_manifest",
          "title": "Record Type",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerIdentity"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "session_id": {
          "$ref": "#/$defs/AssistantSessionId"
        },
        "turn_id": {
          "minLength": 1,
          "title": "Turn Id",
          "type": "string"
        },
        "recent_turn_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Recent Turn Ids",
          "type": "array"
        },
        "durable_memory_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Durable Memory Ids",
          "type": "array"
        },
        "ranking_reasons": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Ranking Reasons",
          "type": "object"
        },
        "exclusions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Exclusions",
          "type": "array"
        },
        "redactions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Redactions",
          "type": "array"
        },
        "retriever_version": {
          "default": "1.0.0",
          "minLength": 1,
          "title": "Retriever Version",
          "type": "string"
        },
        "policy_version": {
          "default": "1.0.0",
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "backend_name": {
          "default": "unknown",
          "minLength": 1,
          "title": "Backend Name",
          "type": "string"
        },
        "model_name": {
          "default": "unknown",
          "minLength": 1,
          "title": "Model Name",
          "type": "string"
        },
        "model_artifact_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Artifact Version"
        },
        "prompt_template_version": {
          "default": "unknown",
          "minLength": 1,
          "title": "Prompt Template Version",
          "type": "string"
        },
        "actual_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Tokens"
        },
        "actual_characters": {
          "default": 0,
          "minimum": 0,
          "title": "Actual Characters",
          "type": "integer"
        },
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AssistantContextManifestItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "producer",
        "session_id",
        "turn_id"
      ],
      "title": "AssistantContextManifest",
      "type": "object"
    },
    "AssistantContextManifestItem": {
      "additionalProperties": false,
      "description": "Item recorded in the assistant context manifest.",
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        },
        "layer": {
          "minLength": 1,
          "title": "Layer",
          "type": "string"
        },
        "data_class": {
          "$ref": "#/$defs/DataClass",
          "default": "LOCAL"
        },
        "ranking_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ranking Reason"
        },
        "fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "redactions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Redactions",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "source_type",
        "layer"
      ],
      "title": "AssistantContextManifestItem",
      "type": "object"
    },
    "AssistantContextPackage": {
      "additionalProperties": false,
      "description": "Reconstructed, bounded context package for an assistant inference.",
      "properties": {
        "record_type": {
          "const": "assistant_context_package",
          "default": "assistant_context_package",
          "title": "Record Type",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerIdentity"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "session_id": {
          "$ref": "#/$defs/AssistantSessionId"
        },
        "turn_id": {
          "minLength": 1,
          "title": "Turn Id",
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/AssistantContextManifest"
        },
        "content": {
          "additionalProperties": true,
          "title": "Content",
          "type": "object"
        },
        "provenance": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProvenanceReference"
          },
          "title": "Provenance",
          "type": "array"
        }
      },
      "required": [
        "producer",
        "session_id",
        "turn_id",
        "manifest",
        "content"
      ],
      "title": "AssistantContextPackage",
      "type": "object"
    },
    "AssistantResponse": {
      "additionalProperties": false,
      "description": "Exactly one terminal outcome for an accepted turn.",
      "properties": {
        "record_type": {
          "const": "assistant_response",
          "default": "assistant_response",
          "title": "Record Type",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerIdentity"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "session_id": {
          "$ref": "#/$defs/AssistantSessionId"
        },
        "turn_id": {
          "minLength": 1,
          "title": "Turn Id",
          "type": "string"
        },
        "user_turn_id": {
          "minLength": 1,
          "title": "User Turn Id",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "manifest_id": {
          "minLength": 1,
          "title": "Manifest Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "status": {
          "default": "COMPLETED",
          "enum": [
            "COMPLETED",
            "FAILED",
            "CANCELLED"
          ],
          "title": "Status",
          "type": "string"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "admitted_memory_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Admitted Memory Ids",
          "type": "array"
        },
        "provenance": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProvenanceReference"
          },
          "title": "Provenance",
          "type": "array"
        }
      },
      "required": [
        "producer",
        "session_id",
        "turn_id",
        "user_turn_id",
        "request_id",
        "manifest_id",
        "text"
      ],
      "title": "AssistantResponse",
      "type": "object"
    },
    "AssistantSessionId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "ConversationTurn": {
      "additionalProperties": false,
      "description": "Immutable user or assistant turn within an assistant session.",
      "properties": {
        "record_type": {
          "const": "conversation_turn",
          "default": "conversation_turn",
          "title": "Record Type",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerIdentity"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "session_id": {
          "$ref": "#/$defs/AssistantSessionId"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "text": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "reply_to_turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reply To Turn Id"
        },
        "data_class": {
          "$ref": "#/$defs/DataClass",
          "default": "LOCAL"
        },
        "status": {
          "default": "ACCEPTED",
          "enum": [
            "ACCEPTED",
            "COMPLETED",
            "FAILED",
            "CANCELLED"
          ],
          "title": "Status",
          "type": "string"
        },
        "provenance": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProvenanceReference"
          },
          "title": "Provenance",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "producer",
        "session_id",
        "role",
        "text"
      ],
      "title": "ConversationTurn",
      "type": "object"
    },
    "DataClass": {
      "description": "Policy classification attached to persisted and outbound data.",
      "enum": [
        "PUBLIC",
        "LOCAL",
        "PRIVATE",
        "SECRET",
        "BLOCKED"
      ],
      "title": "DataClass",
      "type": "string"
    },
