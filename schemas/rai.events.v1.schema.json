        "schema_version": {
          "default": "1.0.0",
          "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "target_resource": {
          "minLength": 1,
          "title": "Target Resource",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "verification_plan": {
