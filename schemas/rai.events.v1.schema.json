    "PolicyOutcome": {
      "description": "Machine-readable policy outcomes.",
      "enum": [
        "ALLOW",
        "ASK",
        "DENY",
        "ESCALATE"
      ],
      "title": "PolicyOutcome",
      "type": "string"
    },
    "ProducerIdentity": {
      "additionalProperties": false,
      "description": "Identity of the component which produced a record.",
      "properties": {
        "device_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Id"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "producer_id": {
          "minLength": 1,
          "title": "Producer Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "producer_id",
        "kind",
        "version"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    },
    "ProvenanceReference": {
      "additionalProperties": false,
      "description": "Typed edge from a derived record to one of its sources.",
      "properties": {
        "producer": {
          "$ref": "#/$defs/ProducerIdentity"
        },
        "relation": {
          "minLength": 1,
          "title": "Relation",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        },
        "source_version": {
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_type",
        "source_version",
        "relation",
        "producer"
      ],
      "title": "ProvenanceReference",
      "type": "object"
    },
    "RiskClass": {
      "description": "Risk associated with invoking a capability.",
      "enum": [
        "LOW",
        "MODERATE",
        "HIGH",
        "CRITICAL"
      ],
      "title": "RiskClass",
      "type": "string"
    },
    "UsageRecord": {
      "additionalProperties": false,
      "properties": {
        "audio_seconds": {
          "minimum": 0,
          "title": "Audio Seconds",
          "type": "number"
        },
        "backend": {
          "minLength": 1,
          "title": "Backend",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "images": {
          "minimum": 0,
          "title": "Images",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_seconds": {
          "minimum": 0,
          "title": "Latency Seconds",
          "type": "number"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "processor": {
          "minLength": 1,
          "title": "Processor",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerIdentity"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "provider_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Cost"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "record_type": {
          "const": "usage_record",
          "default": "usage_record",
          "title": "Record Type",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "tool_calls": {
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "required": [
        "producer",
        "task_id",
        "processor",
        "backend",
        "model",
        "provider",
        "input_tokens",
        "output_tokens",
        "tool_calls",
        "images",
        "audio_seconds",
        "latency_seconds"
      ],
      "title": "UsageRecord",
      "type": "object"
    }
  },
  "$id": "https://tk-lab1.gitlab.io/ai/rai/schemas/rai.events.v1.schema.json",
  "anyOf": [
    {
      "$ref": "#/$defs/EventEnvelope"
    },
    {
      "$ref": "#/$defs/EventBatch"
    }
  ],
  "title": "RAI Event Plane v1",
  "x-rai-schema-version": "1.0.0"
}
