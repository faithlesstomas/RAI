{
  "$defs": {
    "ActionFailure": {
      "additionalProperties": false,
      "properties": {
        "record_type": {
          "const": "action_failure",
          "default": "action_failure",
          "title": "Record Type",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerIdentity"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "capability": {
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "terminal": {
          "const": true,
          "default": true,
          "title": "Terminal",
          "type": "boolean"
        },
        "provenance": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProvenanceReference"
          },
          "title": "Provenance",
          "type": "array"
        }
      },
      "required": [
        "producer",
        "request_id",
        "capability",
        "code",
        "message"
      ],
      "title": "ActionFailure",
      "type": "object"
    },
    "ActionProposal": {
      "additionalProperties": false,
      "description": "Untrusted intent referencing a resource issued by the runtime.",
      "properties": {
        "record_type": {
          "const": "action_proposal",
          "default": "action_proposal",
          "title": "Record Type",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerIdentity"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "source_turn_id": {
          "minLength": 1,
          "title": "Source Turn Id",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "capability": {
          "enum": [
            "application.launch",
            "document.open",
            "browser.open_result",
            "browser.read_page",
            "process.inspect",
            "system.volume.set"
          ],
          "title": "Capability",
          "type": "string"
        },
        "resource_handle": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Resource Handle",
          "type": "string"
        },
        "data_class": {
          "$ref": "#/$defs/DataClass",
          "default": "LOCAL"
        }
      },
      "required": [
        "producer",
        "source_turn_id",
        "task_id",
        "capability",
        "resource_handle"
      ],
      "title": "ActionProposal",
      "type": "object"
    },
    "ActionResult": {
      "additionalProperties": false,
      "properties": {
        "record_type": {
          "const": "action_result",
          "default": "action_result",
          "title": "Record Type",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerIdentity"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "capability": {
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "output": {
          "additionalProperties": true,
          "title": "Output",
          "type": "object"
        },
        "verification": {
          "additionalProperties": true,
          "title": "Verification",
          "type": "object"
        },
        "terminal": {
          "const": true,
          "default": true,
          "title": "Terminal",
          "type": "boolean"
        },
        "provenance": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProvenanceReference"
          },
          "title": "Provenance",
          "type": "array"
        },
        "data_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "producer",
        "request_id",
        "capability",
        "output",
        "verification"
      ],
      "title": "ActionResult",
      "type": "object"
    },
    "DataClass": {
      "description": "Policy classification attached to persisted and outbound data.",
      "enum": [
        "PUBLIC",
        "LOCAL",
        "PRIVATE",
        "SECRET",
        "BLOCKED"
      ],
      "title": "DataClass",
      "type": "string"
    },
    "ProducerIdentity": {
      "additionalProperties": false,
      "description": "Identity of the component which produced a record.",
      "properties": {
        "producer_id": {
          "minLength": 1,
          "title": "Producer Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "device_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Id"
        }
      },
      "required": [
        "producer_id",
        "kind",
        "version"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    },
    "ProvenanceReference": {
      "additionalProperties": false,
      "description": "Typed edge from a derived record to one of its sources.",
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        },
        "source_version": {
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "relation": {
          "minLength": 1,
          "title": "Relation",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerIdentity"
        }
      },
      "required": [
        "source_id",
        "source_type",
        "source_version",
        "relation",
        "producer"
      ],
      "title": "ProvenanceReference",
      "type": "object"
    },
    "ResourceHandle": {
      "additionalProperties": false,
      "description": "Opaque authority; target/fingerprint stay in trusted runtime storage.",
      "properties": {
        "record_type": {
          "const": "resource_handle",
          "default": "resource_handle",
          "title": "Record Type",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerIdentity"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "application",
            "file",
            "url",
            "process",
            "audio_sink"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "fingerprint": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Fingerprint",
          "type": "string"
        },
        "operations": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "data_class": {
          "$ref": "#/$defs/DataClass",
          "default": "LOCAL"
        }
      },
      "required": [
        "producer",
        "actor_id",
        "task_id",
        "kind",
        "target",
        "fingerprint",
        "operations",
        "expires_at"
      ],
      "title": "ResourceHandle",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/ActionProposal"
    },
    {
      "$ref": "#/$defs/ResourceHandle"
    },
    {
      "$ref": "#/$defs/ActionResult"
    },
    {
      "$ref": "#/$defs/ActionFailure"
    }
  ],
  "$id": "https://tk-lab1.gitlab.io/ai/rai/schemas/rai.actions.v1.schema.json",
  "title": "RAI Linux action records v1",
  "x-rai-schema-version": "1.0.0"
}
